<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="simple-backups"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/fingerprint_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:background="@android:color/background_light"
        android:padding="8dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_scan_peer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan / pair desktop"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btn_connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect"
        android:enabled="false"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btn_toggle_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start watch service"
        android:enabled="false"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_full_backup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Push full snapshot"
        android:enabled="false"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btn_lite_backup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Push incremental"
        android:enabled="false"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btn_reset_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset sync state"
        android:enabled="false"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btn_stop_backup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop"
        android:enabled="false" />

</LinearLayout>
</ScrollView>
